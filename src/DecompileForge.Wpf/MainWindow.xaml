<Window x:Class="DecompileForge.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DecompileForge" Height="850" Width="1400" MinHeight="650" MinWidth="1000" Background="#0B1220" Foreground="#E5E7EB">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="7"/><Setter Property="Background" Value="#111827"/><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="BorderBrush" Value="#374151"/></Style>
  </Window.Resources>
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" FontSize="27" FontWeight="SemiBold" Margin="5,0,0,12">DecompileForge · Release Recovery Workbench</TextBlock>
    <StatusBar DockPanel.Dock="Bottom" Background="#111827"><TextBlock Text="{Binding Status}"/></StatusBar>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Margin="5">Baseline source / assembly</TextBlock><TextBox Text="{Binding BaselinePath, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Margin="5">Production release / candidate</TextBlock><TextBox Text="{Binding CandidatePath, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Compare" Command="{Binding CompareCommand}"/><Button Content="Export JSON" Command="{Binding ExportCommand}"/></StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DataGrid Grid.Column="0" ItemsSource="{Binding Differences}" SelectedItem="{Binding SelectedDifference}" AutoGenerateColumns="False" IsReadOnly="True" Background="#111827" Foreground="#E5E7EB" BorderBrush="#374151">
          <DataGrid.Columns><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="70"/><DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="75"/><DataGridTextColumn Header="Difference" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <TabControl Grid.Column="1" Margin="12,0,0,0" Background="#111827" Foreground="#E5E7EB">
          <TabItem Header="Diff"><TextBox Text="{Binding SelectedDifference.UnifiedDiff}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
          <TabItem Header="AI Gap Proposal"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Margin="8">Provider</TextBlock><ComboBox Width="130" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" Margin="5"/><TextBox Width="260" Text="{Binding Model}"/><Button Content="Propose gap fill" Command="{Binding ProposeCommand}"/></StackPanel><TextBox Grid.Row="1" Text="{Binding ProposalText}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Margin="8" Foreground="#FBBF24">AI output is a proposal only. Review, compile, test, and approve before application.</TextBlock></Grid></TabItem>
          <TabItem Header="Audit"><TextBlock Margin="12" TextWrapping="Wrap">Every decompilation and AI request records authorization, hashes, provider metadata, and outcomes in a local append-only JSONL audit trail.</TextBlock></TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
